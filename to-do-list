body{
  font-family: Arial,  sans-serif;
  background-color: rgb(234, 241, 254);
  margin: 0;
  padding: 20px;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  color: black;
}

.app-container {
  background-color: rgb(109, 18, 18);
  padding: 25px;
  border-radius: 8px;
  box-shadow: 0 5px 12px rgba(0, 0, 0, 0.1);
  width: 100%;
  max-width: 400px;
  text-align: center;
}
h1{
  color: rgb(142, 127, 255);
  margin-top: 0%;
  margin-bottom: 20px;
  font-size: 2em;
}

.input-container {
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
}
.input-container  input[type="text"] {
  flex-grow: 1;
  padding: 10px 15px;
  border: 1px solid #ccc;
  border-radius: 4px;
  font-size: 1rem;
  outline: none;
  transition: border-color 0.2s ease-in-out;
}

.input-container input[type="text"]:focus{
  border-color: rgb(249, 48, 17);
}

.add-btn {
  padding: 10px 15px;
  background-color: rgb(5, 34, 24);
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-size: 1rem;
  font-weight: 500;
  transition: background-color 0.3s ease-in-out;
}

.add-btn:hover {
  background-color: rgb(5, 34, 24);
}

.todo-list {
  list-style-type: none;
  padding: 0;
  margin: 0;
  text-align: left;
}

.todo-list li {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 15px;
  background-color: antiquewhite;
  border-radius: 5px;
  border-bottom: 1px solid #eee;
  margin-bottom: 10px;
  cursor: pointer;
  transition: background-color 0.3s ease-in-out;
  word-break: break word;
}

.todo-list li:hover{
  background-color: #f9f9f9;
}
.todo-list li.span{
  flex-grow: 1;
  margin-right: 10px
}

.todo-list li.completed span {
  text-decoration: line-through;
  color: #888;
}

.todo-list li.completed{
  background-color: #e0e0e0;
  border-color: #e0e0e0;
}
.delete-btn{
  padding: 6px 12px;
  background-color: crimson;
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-size: 0.9rem;
  transition: background-color 0.3s ease-in-out;
}

.delete-btn:hover{
  background-color: darkred;
}

.todo-list:empty::after{
  content: "No tasks added yet!";
  display: block;
  text-align: center;
  color: #888;
  font-style: italic;
  margin-top: 20px;
  }
